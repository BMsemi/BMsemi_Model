+def lower(
+    spec: Dict[str, Any],
+    model: Optional[torch.nn.Module] = None,
+    example_input: Optional[torch.Tensor] = None,
+    logger: Optional[CheckpointLogger] = None,
+) -> Dict[str, Any]:
+    """Lower a compile spec into runtime metadata and produce a serialized program.
+
+    This function updates the provided ``spec`` with a ``runtime`` section
+    describing where the compiled program has been saved and which runtime
+    dispatcher should be used. It attempts to compile the model using the
+    optional ExecuTorch compiler when available, and falls back to
+    TorchScript tracing otherwise. When neither compilation path
+    succeeds a placeholder metadata is inserted and the caller is
+    responsible for providing a program artefact by other means.
+
+    Args:
+        spec: A compile specification dictionary as returned by
+            ``executorch_compile_spec.get_spec``.
+        model: The ``nn.Module`` to compile. If ``None``, no new
+            compilation is attempted and only the metadata is updated.
+        example_input: An example input tensor required to trace the model.
+        logger: Optional ``CheckpointLogger`` used for consistency checks.
+
+    Returns:
+        A copy of ``spec`` with a ``runtime`` entry.
+    """
+    updated = deepcopy(spec)
+    serialized_path: Optional[str] = None
+    if model is not None and example_input is not None:
+        if executorch is not None:
+            try:
+                program = executorch.compile(model.eval(), example_input)
+                serialized_path = "artifacts/executorch_program.pte"
+                Path(serialized_path).parent.mkdir(parents=True, exist_ok=True)
+                program.save(serialized_path)
+            except Exception:
+                serialized_path = None
+        if serialized_path is None:
+            try:
+                script_module = torch.jit.trace(model.eval(), example_input)
+                serialized_path = "artifacts/executorch_program.pte"
+                Path(serialized_path).parent.mkdir(parents=True, exist_ok=True)
+                script_module.save(serialized_path)
+            except Exception:
+                serialized_path = None
+    updated["runtime"] = {
+        "serialized_program": serialized_path or "artifacts/executorch_program.pte",
+        "delegate_runtime": "runtime_dispatcher",
+        "debug_handles": True,
+    }
+    if logger is not None:
+        logger.check(
+            name="executorch_runtime_has_debug_handles",
+            condition=bool(updated["runtime"]["debug_handles"]),
+            details="Lowered compile spec to a runtime-ready metadata blob.",
+            payload=updated["runtime"],
+        )
+    return updated
