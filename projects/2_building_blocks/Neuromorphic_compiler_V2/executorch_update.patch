+def preprocess(spec: Dict[str, Any], logger: Optional[CheckpointLogger] = None) -> Dict[str, Any]:
+    """Insert delegate preprocessing metadata into the compile spec.
+
+    The delegate preprocessing stage identifies which operator classes should
+    be offloaded to the ExecuTorch delegate. Users can customize the
+    ``bmsemi_partition_tags`` list to include any operators supported by
+    the underlying neuromorphic accelerator. When a checkpoint logger is
+    provided the function records a validation checkpoint.
+
+    Args:
+        spec: A compile specification dictionary.
+        logger: Optional ``CheckpointLogger`` used to record validation
+            checkpoints.
+
+    Returns:
+        A copy of ``spec`` with a ``delegate`` entry.
+    """
